# Copier en .env et renseigner les valeurs réelles. Ne jamais committer le .env rempli.

# Docker Hub — image publiée par le workflow api-cd.yml
DOCKERHUB_NAMESPACE=change-me
API_IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=ussd_automation
POSTGRES_USER=ussd_automation
POSTGRES_PASSWORD=change-me

# API — publié uniquement sur 127.0.0.1, derrière le Nginx système (Certbot).
# API_PORT doit être identique à server.port dans api/src/main/resources/application.yml
# (8080 par défaut occupé sur ce serveur par un autre service -> 8089 ici).
MERCHANT_API_KEY=change-me
API_PORT=8089

# Chemin absolu, sur le serveur, vers le JSON de compte de service Firebase
FIREBASE_CREDENTIALS_FILE=/opt/ussd-automation/firebase-service-account.json
