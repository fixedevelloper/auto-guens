# Copier en .env.local pour le dev, jamais committer le fichier rempli.

# URL interne de l'API Spring (dans docker-compose : http://api:8080)
API_BASE_URL=http://localhost:8080
MERCHANT_API_KEY=changeme-dev-only

# Mot de passe unique pour se connecter à cette admin
ADMIN_PASSWORD=change-me

# Secret de signature du cookie de session (ex: openssl rand -base64 32)
SESSION_SECRET=change-me
